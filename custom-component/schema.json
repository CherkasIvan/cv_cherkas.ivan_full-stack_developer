{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "id": "CustomComponentSchema",
    "title": "Custom Angular Component",
    "description": "Генератор кастомного Angular компонента с OnPush и standalone",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Имя компонента (например, 'user-profile')",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$",
            "x-prompt": "Введите имя компонента:"
        },
        "path": {
            "type": "string",
            "description": "Путь для создания компонента (относительно src/app)",
            "default": "components",
            "x-prompt": "Введите путь (по умолчанию 'components'):"
        },
        "prefix": {
            "type": "string",
            "description": "Префикс для селектора",
            "default": "app",
            "x-prompt": "Введите префикс селектора (по умолчанию 'app'):"
        },
        "withSignals": {
            "type": "boolean",
            "description": "Добавить пример использования сигналов?",
            "default": true
        },
        "withPrimeNG": {
            "type": "boolean",
            "description": "Добавить базовый импорт PrimeNG?",
            "default": false
        }
    },
    "required": ["name"],
    "additionalProperties": false
}
