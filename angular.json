{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "projects": {
        "cv_cherkas.ivan_full-stack_developer": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "standalone": true,
                    "changeDetection": "OnPush",
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "cv",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/cv_cherkas.ivan_full-stack_developer",
                            "browser": "browser"
                        },
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "**/*",
                                "input": "src/assets/i18n",
                                "output": "assets/i18n"
                            }
                        ],
                        "styles": [
                            "src/styles.scss",
                            "node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "baseHref": "/cv_cherkas.ivan_full-stack_developer/",
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "4MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "16kB",
                                    "maximumError": "32kB"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": true,
                            "sourceMap": false
                        },
                        "netlify": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.netlify.ts"
                                }
                            ],
                            "baseHref": "/",
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "4MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "16kB",
                                    "maximumError": "32kB"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": true,
                            "sourceMap": false
                        },
                        "development": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.development.ts"
                                }
                            ],
                            "baseHref": "/",
                            "optimization": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "port": 4200,
                        "open": true
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:production"
                        },
                        "netlify": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:netlify"
                        },
                        "development": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "tsconfig.spec.json"
                    }
                },
                "deploy": {
                    "builder": "angular-cli-ghpages:deploy",
                    "options": {
                        "baseHref": "/cv_cherkas.ivan_full-stack_developer/",
                        "deployBranch": "gh-pages",
                        "keepPolyfills": true
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:production"
                        }
                    }
                }
            }
        }
    }
}
