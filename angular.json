{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "projects": {
        "cv_cherkas.ivan_full-stack_developer": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "standalone": true,
                    "changeDetection": "OnPush",
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "cv",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/cv_cherkas.ivan_full-stack_developer",
                            "browser": "browser"
                        },
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "**/*",
                                "input": "src/assets/i18n",
                                "output": "/assets/i18n"
                            },
                            {
                                "glob": "**/*",
                                "input": "src/manifest.webmanifest",
                                "output": "/"
                            }
                        ],
                        "styles": [
                            "src/styles.scss",
                            "node_modules/primeicons/primeicons.css"
                        ],
                        "scripts": [],
                        "serviceWorker": "src/ngsw-config.json"
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "baseHref": "/cv_cherkas.ivan_full-stack_developer/",
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "4MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "16kB",
                                    "maximumError": "32kB"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": true
                                },
                                "fonts": true
                            },
                            "sourceMap": {
                                "scripts": false,
                                "styles": false,
                                "vendor": false,
                                "hidden": false
                            },
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "serviceWorker": true
                        },
                        "netlify": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.netlify.ts"
                                }
                            ],
                            "baseHref": "/",
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "4MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "16kB",
                                    "maximumError": "32kB"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": true
                                },
                                "fonts": true
                            },
                            "sourceMap": {
                                "scripts": false,
                                "styles": false,
                                "vendor": false,
                                "hidden": false
                            },
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "serviceWorker": true
                        },
                        "development": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.development.ts"
                                }
                            ],
                            "baseHref": "/",
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true,
                            "vendorChunk": true,
                            "buildOptimizer": false,
                            "serviceWorker": false
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "port": 4200,
                        "open": true,
                        "host": "localhost"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:production"
                        },
                        "netlify": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:netlify"
                        },
                        "development": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "cv_cherkas.ivan_full-stack_developer:build"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "tsconfig.spec.json"
                    }
                },
                "deploy": {
                    "builder": "angular-cli-ghpages:deploy",
                    "options": {
                        "baseHref": "/cv_cherkas.ivan_full-stack_developer/",
                        "deployBranch": "gh-pages",
                        "keepPolyfills": true
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "cv_cherkas.ivan_full-stack_developer:build:production"
                        }
                    }
                }
            }
        }
    }
}
