{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "cv_cherkas.ivan_full-stack_developer",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.html",
                    "/manifest.json",
                    "/*.css",
                    "/*.js"
                ]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": ["/icons/**"]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "api",
            "urls": ["/api/**"],
            "cacheConfig": {
                "maxSize": 20,
                "maxAge": "1h",
                "strategy": "freshness"
            }
        }
    ]
}
